From ee2ee747b03d910f4cd6a893624d873a7c33d093 Mon Sep 17 00:00:00 2001
From: NurKeinNeid <nurkeinneid@derpfest.org>
Date: Sun, 20 Jul 2025 01:55:46 +0200
Subject: [PATCH 28/28] Launcher3: Refactor themed icon handling to use
 ThemeManager in all apps and search layouts

Change-Id: I0e8bf003d857d2290be5696adbcbcb861554ba5d
Signed-off-by: NurKeinNeid <nurkeinneid@derpfest.org>
---
 src/com/android/launcher3/qsb/QsbLayout.java | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/com/android/launcher3/qsb/QsbLayout.java b/src/com/android/launcher3/qsb/QsbLayout.java
index bc5bb1394c..397addb781 100644
--- a/src/com/android/launcher3/qsb/QsbLayout.java
+++ b/src/com/android/launcher3/qsb/QsbLayout.java
@@ -19,6 +19,7 @@ import com.android.launcher3.Utilities;
 import com.android.launcher3.qsb.QsbContainerView;
 import com.android.launcher3.util.MultiTranslateDelegate;
 import com.android.launcher3.util.Themes;
+import com.android.launcher3.graphics.ThemeManager;
 import com.android.launcher3.LauncherPrefs;
 
 public class QsbLayout extends FrameLayout implements Reorderable,
@@ -80,13 +81,13 @@ public class QsbLayout extends FrameLayout implements Reorderable,
 
     @Override
     public void onSharedPreferenceChanged(SharedPreferences prefs, String key) {
-        if (key.equals(Themes.KEY_THEMED_ICONS)) {
+        if (key.equals(ThemeManager.KEY_THEMED_ICONS)) {
             setIcons();
         }
     }
 
     private void setIcons() {
-        if (Themes.isThemedIconEnabled(mContext)) {
+        if (ThemeManager.INSTANCE.get(mContext).isMonoThemeEnabled()) {
             mAssistantIcon.setImageResource(R.drawable.ic_mic_themed);
             mGoogleIcon.setImageResource(R.drawable.ic_super_g_themed);
             mLensIcon.setImageResource(R.drawable.ic_lens_themed);
-- 
