From 70c40eb1b3c3a4fb0af8e04c6f3c367da244fd3d Mon Sep 17 00:00:00 2001
From: Abhay Singh Gill <abhaygill017@gmail.com>
Date: Tue, 24 Dec 2024 18:38:08 +0530
Subject: [PATCH 25/28] Launcher3: Improve QSB layout

Signed-off-by: Abhay Singh Gill <abhaygill017@gmail.com>
---
 res/layout/search_container_hotseat.xml | 35 +++++++++++--------------
 res/values/config.xml                   |  4 +--
 res/values/dimens.xml                   | 12 ++++-----
 3 files changed, 23 insertions(+), 28 deletions(-)

diff --git a/res/layout/search_container_hotseat.xml b/res/layout/search_container_hotseat.xml
index 0b0c58a846..127ecbb4de 100644
--- a/res/layout/search_container_hotseat.xml
+++ b/res/layout/search_container_hotseat.xml
@@ -1,11 +1,12 @@
 <?xml version="1.0" encoding="utf-8"?>
-<com.android.launcher3.qsb.QsbLayout xmlns:android="http://schemas.android.com/apk/res/android"
-    xmlns:tools="http://schemas.android.com/tools"
+<com.android.launcher3.qsb.QsbLayout 
+    xmlns:android="http://schemas.android.com/apk/res/android"
     android:layout_width="match_parent"
     android:layout_height="@dimen/qsb_widget_height"
     android:layout_alignParentTop="true"
     android:layout_centerHorizontal="true"
-    android:layout_gravity="center|top"
+    android:layout_gravity="top|center_horizontal"
+    
     android:background="@drawable/bg_google_qsb"
     android:backgroundTint="@color/hotseat_qsb_bg_color"
     android:contentDescription="@string/label_search">
@@ -14,47 +15,41 @@
         android:id="@+id/g_icon"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
-        android:layout_gravity="start|center"
+        android:layout_gravity="start|center_vertical"
         android:layout_marginStart="@dimen/qsb_g_icon_marginStart"
         android:src="@drawable/ic_super_g_color" />
 
     <LinearLayout
         android:layout_width="wrap_content"
         android:layout_height="match_parent"
-        android:layout_gravity="end|center"
-        android:layout_marginTop="6dp"
-        android:layout_marginBottom="6dp"
-        android:paddingStart="6dp"
-        android:clipToPadding="false"
-        android:orientation="horizontal"
-        tools:ignore="RtlSymmetry">
+        android:layout_gravity="end|center_vertical"
+        android:layout_marginTop="-6dp"
+        android:layout_marginBottom="-6dp"
+        android:layout_marginEnd="@dimen/qsb_marginEnd"
+        android:orientation="horizontal">
 
         <com.android.launcher3.qsb.AssistantIconView
             android:id="@+id/mic_icon"
-            android:layout_width="@dimen/qsb_icon_width"
+            android:layout_width="@dimen/qsb_icon_tap_size"
             android:layout_height="match_parent"
-            android:layout_marginStart="-6dp"
             android:background="@drawable/pill_ripple"
             android:clickable="true"
             android:contentDescription="@string/label_voice_search"
             android:scaleType="fitCenter"
             android:focusable="false"
-            android:padding="@dimen/qsb_icon_padding"
-            tools:src="@drawable/ic_mic_color" />
+            android:src="@drawable/ic_mic_color" />
 
         <ImageButton
             android:id="@+id/lens_icon"
-            android:layout_width="@dimen/qsb_icon_width"
+            android:layout_width="@dimen/qsb_icon_tap_size"
             android:layout_height="match_parent"
-            android:layout_marginStart="-6dp"
             android:background="@drawable/pill_ripple"
             android:clickable="true"
             android:contentDescription="@string/label_lens"
             android:focusable="false"
-            android:padding="@dimen/qsb_icon_padding"
+            android:padding="@dimen/qsb_lens_padding"
             android:scaleType="fitCenter"
             android:visibility="gone"
-            tools:src="@drawable/ic_lens_color"
-            tools:visibility="visible" />
+            android:src="@drawable/ic_lens_color" />
     </LinearLayout>
 </com.android.launcher3.qsb.QsbLayout>
diff --git a/res/values/config.xml b/res/values/config.xml
index a17eeaace8..7510c991b9 100644
--- a/res/values/config.xml
+++ b/res/values/config.xml
@@ -81,8 +81,8 @@
 
     <!-- Scalable Grid configuration -->
     <!-- This is a float because it is converted to dp later in DeviceProfile -->
-    <dimen name="hotseat_bar_bottom_space_default">16</dimen>
-    <dimen name="hotseat_qsb_space_default">24</dimen>
+    <dimen name="hotseat_bar_bottom_space_default">48</dimen>
+    <dimen name="hotseat_qsb_space_default">36</dimen>
 
     <!-- Whether to enable background preloading of task thumbnails. -->
     <bool name="config_enableTaskSnapshotPreloading">true</bool>
diff --git a/res/values/dimens.xml b/res/values/dimens.xml
index 1913a3f518..46b82854eb 100644
--- a/res/values/dimens.xml
+++ b/res/values/dimens.xml
@@ -42,11 +42,11 @@
 
     <dimen name="qsb_g_icon_marginStart">16dp</dimen>
     <dimen name="qsb_lens_padding">8dp</dimen>
-    <dimen name="qsb_min_width_with_mic">124dp</dimen>
+    <dimen name="qsb_marginEnd">4dp</dimen>
     <dimen name="qsb_shadow_margin">6dp</dimen>
-    <dimen name="qsb_widget_height">64dp</dimen>
-    <dimen name="qsb_icon_width">56dp</dimen>
-    <dimen name="qsb_icon_padding">10dp</dimen>
+    <dimen name="qsb_widget_height">63dp</dimen>
+    <dimen name="qsb_icon_tap_size">48dp</dimen>
+    <dimen name="qsb_icon_padding">8dp</dimen>
 
     <!-- Scalable Grid -->
     <dimen name="min_qsb_margin">8dp</dimen>
@@ -455,10 +455,10 @@
         @*android:dimen/rounded_corner_content_padding
     </dimen>
     <dimen name="taskbar_stashed_size">0dp</dimen>
-    <dimen name="qsb_shadow_height">0dp</dimen>
+    <dimen name="qsb_shadow_height">6dp</dimen>
     <dimen name="min_hotseat_icon_space">18dp</dimen>
     <dimen name="max_hotseat_icon_space">50dp</dimen>
-    <dimen name="min_hotseat_qsb_width">0dp</dimen>
+    <dimen name="min_hotseat_qsb_width">240dp</dimen>
     <dimen name="taskbar_running_app_indicator_height">0dp</dimen>
     <dimen name="taskbar_running_app_indicator_width">0dp</dimen>
     <dimen name="taskbar_running_app_indicator_top_margin">0dp</dimen>
-- 
2.51.1

