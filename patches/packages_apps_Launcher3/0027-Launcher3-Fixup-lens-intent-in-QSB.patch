From 0f5c599774391c1864949a40d47b3374626d978d Mon Sep 17 00:00:00 2001
From: Abhay Singh Gill <abhaygill017@gmail.com>
Date: Wed, 25 Dec 2024 12:42:43 +0530
Subject: [PATCH 27/28] Launcher3: Fixup lens intent in QSB

Signed-off-by: Abhay Singh Gill <abhaygill017@gmail.com>
---
 src/com/android/launcher3/Utilities.java     |  2 +-
 src/com/android/launcher3/qsb/QsbLayout.java | 11 ++++-------
 2 files changed, 5 insertions(+), 8 deletions(-)

diff --git a/src/com/android/launcher3/Utilities.java b/src/com/android/launcher3/Utilities.java
index 517e586b4d..fb5582af52 100644
--- a/src/com/android/launcher3/Utilities.java
+++ b/src/com/android/launcher3/Utilities.java
@@ -155,7 +155,7 @@ public final class Utilities {
     public @interface AdjustmentDirection{}
 
     public static final String GSA_PACKAGE = "com.google.android.googlequicksearchbox";
-    public static final String LENS_ACTIVITY = "com.google.android.apps.lens.MainActivity";
+    public static final String LENS_ACTIVITY = "com.google.android.apps.search.lens.LensExportedActivity";
     public static final String LENS_URI = "google://lens";
 
     public static final String KEY_DOCK_SEARCH = "pref_dock_search";
diff --git a/src/com/android/launcher3/qsb/QsbLayout.java b/src/com/android/launcher3/qsb/QsbLayout.java
index 0bb50306c7..bc5bb1394c 100644
--- a/src/com/android/launcher3/qsb/QsbLayout.java
+++ b/src/com/android/launcher3/qsb/QsbLayout.java
@@ -101,14 +101,11 @@ public class QsbLayout extends FrameLayout implements Reorderable,
         mLensIcon.setVisibility(View.VISIBLE);
         mLensIcon.setOnClickListener(view -> {
             Intent lensIntent = new Intent();
-            Bundle bundle = new Bundle();
-            bundle.putString("caller_package", Utilities.GSA_PACKAGE);
-            bundle.putLong("start_activity_time_nanos", SystemClock.elapsedRealtimeNanos());
-            lensIntent.setComponent(new ComponentName(Utilities.GSA_PACKAGE, Utilities.LENS_ACTIVITY))
-                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK)
-                    .setPackage(Utilities.GSA_PACKAGE)
+            lensIntent.setAction(Intent.ACTION_VIEW)
+                    .setComponent(new ComponentName(Utilities.GSA_PACKAGE, Utilities.LENS_ACTIVITY))
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                     .setData(Uri.parse(Utilities.LENS_URI))
-                    .putExtra("lens_activity_params", bundle);
+                    .putExtra("LensHomescreenShortcut", true);
             mContext.startActivity(lensIntent);
         });
     }
-- 
